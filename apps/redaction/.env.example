# URL publique de cette app (prod : https://wab-infos.com/redaction — voir deploy/public_html/passenger-web-with-redaction-path.htaccess.example)
NEXT_PUBLIC_REDACTION_URL=http://localhost:3001

# Site lecteur (liens retour + proxy veille concurrence /api/seo/competition)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Wab-infos

# Strapi
STRAPI_URL=http://localhost:8090
NEXT_PUBLIC_STRAPI_URL=http://localhost:8090
STRAPI_API_TOKEN=

# Rôles Strapi users-permissions (noms exacts, séparés par des virgules — optionnel)
# REDACTION_SUPER_ADMIN_ROLES=SuperAdmin,Super Admin
# REDACTION_EDITOR_ROLES=Editor,Éditeur
# Admin / SuperAdmin : suppression de tout article ; rédacteurs : brouillons uniquement

# CMS admin (lien depuis login)
NEXT_PUBLIC_CMS_URL=http://localhost:8090

# Connexion Google — bouton affiché par défaut (masquer avec =false)
# NEXT_PUBLIC_REDACTION_GOOGLE_AUTH=false
# Domaines e-mail autorisés (serveur) — obligatoire en prod
REDACTION_GOOGLE_ALLOWED_DOMAINS=wab-infos.com
# Secrets OAuth (même client Google Cloud que le CMS)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Redirect URI Google Cloud (défaut : {REDACTION_URL}/api/redaction/auth/google/oauth-callback)
# REDACTION_GOOGLE_OAUTH_REDIRECT_URI=https://redaction.app.wab-infos.com/api/redaction/auth/google/oauth-callback

# Firebase push éditeurs
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Le fichier public/firebase-messaging-config.js est généré par npm run pwa:fcm (non versionné)

# Secret interne CMS (rôles admin après connexion Google, revalidation cache)
# Même valeur que apps/cms et apps/web — obligatoire en prod pour les privilèges admin Google
REVALIDATION_SECRET=

# Push lecteurs (publication article → notification APK)
PUSH_SEND_ON_PUBLISH=true
PUSH_SECRET=

# --- Recherche web de l'IA (optionnel) ---
# Sans clé : Google News, Bing News, médias congolais (REST WordPress),
# DuckDuckGo et Bing fonctionnent déjà.
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SERPER_API_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=

# RH (optionnel, côté serveur uniquement) : base PostgreSQL privée séparée, rôle à droits limités.
# REDACTION_RH_DATABASE_URL=postgresql://rh_runtime:password@db-host:5432/redaction_rh?sslmode=verify-full
# Origines exactes autorisées pour les écritures, séparées par des virgules (obligatoire en production).
# REDACTION_RH_ALLOWED_ORIGINS=https://wab-infos.com,https://redaction.app.wab-infos.com

# RH : suivi indicatif des rémunérations manuelles, désactivé par défaut.
# Ne pas activer avant migration, contrôles de sécurité et validation des règles en RDC.
# REDACTION_RH_FINANCE_ENABLED=false
# RH : retraits expérimentaux, désactivés par défaut. Ne pas activer en production.
# REDACTION_RH_WITHDRAWALS_ENABLED=false
# Rôles RH dédiés : désactivés par défaut ; tester identité et permissions en préproduction.
# REDACTION_RH_ROLES_ENABLED=false
# Notifications RH internes (pas de push) ; activer après migration et tests de préproduction.
# REDACTION_RH_NOTIFICATIONS_ENABLED=false
# Documents RH privés : désactivés par défaut. Exige base chiffrée, sauvegardes et validation sécurité.
# REDACTION_RH_DOCUMENTS_ENABLED=false

# Contestations privées : désactivées par défaut ; migration et tests requis.
# REDACTION_RH_DISPUTES_ENABLED=false

# Notifications internes pour les gestionnaires RH ; migration et droits requis.
# REDACTION_RH_MANAGEMENT_NOTIFICATIONS_ENABLED=false
